# Copy this file to .env and fill in your key. Never commit the real .env.
ANTHROPIC_API_KEY=your_key_here

# Optional settings (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Cap on output tokens per Claude call; thinking counts toward it, so keep it generous.
MAX_OUTPUT_TOKENS=6000
# OCR engine for photo uploads: auto (Tesseract if installed, else Claude vision), tesseract, or claude
# OCR_ENGINE=auto
# Requests per IP per hour for the endpoints that call Claude (0 = unlimited)
# RATE_LIMIT_PER_HOUR=30
# MAX_DOCUMENT_CHARS=20000
# MAX_UPLOAD_MB=10
# Documents processed at once; extra requests get a "busy" reply
# MAX_CONCURRENT_JOBS=8
# ANTHROPIC_TIMEOUT_SECONDS=150
# OCR_MAX_TOKENS=16000
# Only needed if the frontend is hosted on a different origin
# ALLOWED_ORIGINS=https://example.com
